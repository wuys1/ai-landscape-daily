# Optional OpenAI-compatible LLM provider for extraction upgrades.
# Any provider that implements /v1/chat/completions can be used.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=15

# Public report URL used in email links, for example:
# https://<owner>.github.io/<repo>/daily/2026-06-28/
REPORT_BASE_URL=

# Email delivery. Resend is used when RESEND_API_KEY is present; SMTP is a fallback.
EMAIL_TO=
EMAIL_FROM=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
